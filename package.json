{
  "name": "term-dad",
  "version": "0.1.0",
  "description": "Local MCP control plane for visible WezTerm agents",
  "type": "module",
  "bin": {
    "term-dad": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "scripts/screenshot-*",
    "scripts/notify-*",
    "scripts/launch-local"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:live": "node --import tsx scripts/live.ts",
    "start": "node dist/index.js",
    "check": "npm run build && npm test",
    "test:agent": "node --import tsx scripts/live-agent.ts",
    "test:screenshot": "node --import tsx scripts/live-screenshot.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
