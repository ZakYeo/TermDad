#!/bin/sh
# Resolve tools on the MCP host for local terminal domains (including WSL).
set -eu
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
node_bin=$(command -v node)
if [ -z "${TERM_DAD_CLAUDE_COMMAND:-}" ] && command -v claude >/dev/null 2>&1; then
  TERM_DAD_CLAUDE_COMMAND=$("$node_bin" -e 'console.log(JSON.stringify(process.argv.slice(1)))' "$(command -v claude)")
  export TERM_DAD_CLAUDE_COMMAND
fi
if [ -z "${TERM_DAD_CODEX_COMMAND:-}" ] && command -v codex >/dev/null 2>&1; then
  TERM_DAD_CODEX_COMMAND=$("$node_bin" --input-type=module -e '
    import {readFileSync,realpathSync} from "node:fs";
    const file=realpathSync(process.argv[1]);
    const isNode=readFileSync(file).subarray(0,100).toString().startsWith("#!/usr/bin/env node");
    console.log(JSON.stringify(isNode?[process.execPath,file]:[file]));
  ' "$(command -v codex)")
  export TERM_DAD_CODEX_COMMAND
fi
exec "$node_bin" "$script_dir/../dist/index.js"
