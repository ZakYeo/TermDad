#!/bin/sh
# Load the user's shell environment in local worker panes (including WSL).
set -eu
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
node_bin=$(command -v node)
# Only construct argv here: startup files must run in the worker pane, never on
# the MCP server's protocol stdout. Resolve CLIs after shell startup, not before.
worker_command() {
  "$node_bin" --input-type=module -e '
    import {basename} from "node:path";
    const shell = process.env.TERM_DAD_LOCAL_SHELL || process.env.SHELL || "/bin/sh";
    const name = basename(shell);
    let prefix;
    if (name === "fish") prefix = [shell, "-lic", "exec $argv"];
    else if (["sh", "dash", "bash", "zsh", "ksh"].includes(name))
      prefix = [shell, "-lic", "exec \"$@\"", "term-dad-worker"];
    else {
      console.error("Unsupported local shell; launching " + process.argv[1] + " directly without shell startup. Set TERM_DAD_LOCAL_SHELL to a supported shell or configure agent command overrides.");
      prefix = [];
    }
    console.log(JSON.stringify([...prefix, process.argv[1]]));
  ' "$1"
}
if [ -z "${TERM_DAD_CLAUDE_COMMAND:-}" ]; then
  TERM_DAD_CLAUDE_COMMAND=$(worker_command claude)
  export TERM_DAD_CLAUDE_COMMAND
fi
if [ -z "${TERM_DAD_CODEX_COMMAND:-}" ]; then
  TERM_DAD_CODEX_COMMAND=$(worker_command codex)
  export TERM_DAD_CODEX_COMMAND
fi
exec "$node_bin" "$script_dir/../dist/index.js"
